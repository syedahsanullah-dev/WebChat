# ==============================================================================
# SERVER #2: FASTIFY + NATIVE WS DAEMON ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV="production"

# Server Port (Hostinger sets this dynamically via process.env.PORT)
PORT=4000

# Allowed CORS Origin (Allows connections from your Next.js frontend)
CORS_ORIGIN="https://chat.vusigma.com"

# Hostinger MySQL Database Connection String (Strictly connection_limit=10)
# Note: '#5199#WEBCHAT.com' password is URL-encoded as '%235199%23WEBCHAT.com' for Prisma MySQL compatibility
DATABASE_URL="mysql://u946657530_chatuser:%235199%23WEBCHAT.com@127.0.0.1:3306/u946657530_webchat?connection_limit=10&pool_timeout=20"

# Shared JWT Secret (MUST match Server #1 JWT_SECRET exactly)
JWT_SECRET="f2ccc8e1a8baca7a6dd935c0a2a9ec98b278c99bc99a7a334fab3c3f7b867529"

# Heartbeat Ping-Pong Interval in milliseconds (Hostinger 25s keep-alive)
PING_INTERVAL_MS=25000

# Client Typing Throttling in milliseconds (Protects CPU)
TYPING_THROTTLE_MS=2500

# Server #1 Base URL for offline push dispatch
NEXT_API_URL="https://chat.vusigma.com"
INTERNAL_API_SECRET="f2ccc8e1a8baca7a6dd935c0a2a9ec98b278c99bc99a7a334fab3c3f7b867529"
