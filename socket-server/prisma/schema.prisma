datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique(map: "idx_users_username") @db.VarChar(30)
  email        String   @unique(map: "idx_users_email") @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  displayName  String   @db.VarChar(100)
  avatarUrl    String?  @db.VarChar(500)
  about        String   @default("Hey there! I am using WebChat.") @db.VarChar(255)
  isOnline     Boolean  @default(false)
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  contacts         Contact[]         @relation("UserContacts")
  addedByContacts  Contact[]         @relation("ContactAddedBy")
  chatParticipants ChatParticipant[]
  sentMessages     Message[]
  messageStatuses  MessageStatus[]
  adminOfGroups    Chat[]            @relation("GroupAdmin")
  initiatedCalls   CallLog[]         @relation("CallerUser")
  receivedCalls    CallLog[]         @relation("ReceiverUser")
  sessions         UserSession[]
  publicKey        UserPublicKey?
  pushSubscriptions UserPushSubscription[]
  webhooksCreated  Webhook[]           @relation("WebhookCreator")
  reminders        ScheduledReminder[]
  pollsCreated     Poll[]              @relation("PollCreator")
  pollVotes        PollVote[]
  pinnedMessages   PinnedMessage[]
  starredMessages  StarredMessage[]
  systemRole       String            @default("USER") @db.VarChar(20) // "SUPER_ADMIN", "ADMIN", "MODERATOR", "USER"
  isSuspended      Boolean           @default(false)
  auditLogs        AuditLog[]
  broadcasts       SystemBroadcast[]

  @@index([systemRole], map: "idx_users_system_role")
  @@index([isSuspended], map: "idx_users_suspended")
  @@index([createdAt(sort: Desc)], map: "idx_users_created")
  @@map("users")
}

model Contact {
  id            String   @id @default(uuid())
  userId        String
  contactUserId String
  aliasName     String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  user        User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactUser User @relation("ContactAddedBy", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId], map: "idx_user_contact_unique")
  @@map("contacts")
}

model Chat {
  id               String   @id @default(uuid())
  isGroup          Boolean  @default(false)
  isChannel        Boolean  @default(false)
  groupTitle       String?  @db.VarChar(100)
  groupDescription String?  @db.VarChar(500)
  groupAvatarUrl   String?  @db.VarChar(500)
  groupAdminId     String?
  lastMessageId    String?
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  admin           User?               @relation("GroupAdmin", fields: [groupAdminId], references: [id], onDelete: SetNull)
  participants    ChatParticipant[]
  messages        Message[]
  callLogs        CallLog[]
  webhooks        Webhook[]
  reminders       ScheduledReminder[]
  polls           Poll[]
  channelMetadata ChannelMetadata?
  pinnedMessages  PinnedMessage[]

  @@index([lastMessageAt(sort: Desc)], map: "idx_chats_last_message_at")
  @@map("chats")
}

model ChatParticipant {
  id         String   @id @default(uuid())
  chatId     String
  userId     String
  role       String   @default("member") @db.VarChar(20) // "admin" or "member"
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId], map: "idx_chat_user_unique")
  @@map("chat_participants")
}

model Message {
  id               String   @id @default(uuid())
  chatId           String
  senderId         String
  messageType      String   @default("text") @db.VarChar(20) // "text", "image", "voice", "system"
  content          String?  @db.Text
  mediaUrl         String?  @db.VarChar(500)
  mediaSize        Int?
  mediaDuration    Float? // In seconds, for voice notes
  replyToMessageId String?
  isDeleted        Boolean  @default(false)
  isE2EE           Boolean  @default(false)
  e2eeIv           String?  @db.VarChar(50) // Base64 encoded 12-byte IV for AES-GCM
  latitude         Float?
  longitude        Float?
  locationAddress  String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chat           Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender         User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  statuses       MessageStatus[]
  pinnedIn       PinnedMessage[]
  starredBy      StarredMessage[]

  @@index([chatId, createdAt(sort: Desc)], map: "idx_messages_chat_created")
  @@map("messages")
}

model MessageStatus {
  id        String   @id @default(uuid())
  messageId String
  userId    String // Recipient user
  status    String   @default("sent") @db.VarChar(20) // "sent", "delivered", "read"
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId], map: "idx_message_user_status_unique")
  @@map("message_statuses")
}

model CallLog {
  id         String    @id @default(uuid())
  chatId     String
  callerId   String
  receiverId String
  callType   String    @default("audio") @db.VarChar(20) // "audio" (video disabled)
  status     String    @db.VarChar(20) // "missed", "completed", "rejected", "busy"
  duration   Int       @default(0) // Seconds
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  chat     Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  caller   User @relation("CallerUser", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverUser", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([chatId, startedAt(sort: Desc)], map: "idx_call_logs_chat_started")
  @@map("call_logs")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  sessionToken String    @unique(map: "idx_sessions_token") @db.VarChar(255)
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.Text
  deviceType   String    @default("DESKTOP") @db.VarChar(20) // "DESKTOP", "MOBILE", "TABLET", "UNKNOWN"
  browser      String?   @db.VarChar(50)                    // "Chrome", "Firefox", "Safari", "Edge"
  os           String?   @db.VarChar(50)                    // "Windows", "macOS", "Linux", "Android", "iOS"
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActiveAt(sort: Desc)], map: "idx_sessions_user_active")
  @@map("user_sessions")
}

model UserPublicKey {
  id        String   @id @default(uuid())
  userId    String   @unique(map: "idx_user_public_key")
  publicKey String   @db.Text // Base64 encoded exported SPKI public key
  algorithm String   @default("ECDH-P256") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_public_keys")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   @db.VarChar(50)
  resource  String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt(sort: Desc)], map: "idx_audit_action_created")
  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_user_created")
  @@map("audit_logs")
}

model DlpRule {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  pattern    String   @db.Text
  category   String   @db.VarChar(50) // "CREDENTIALS", "FINANCIAL", "IDENTITY", "CUSTOM"
  action     String   @default("BLOCK") @db.VarChar(20) // "BLOCK", "WARN", "LOG"
  isActive   Boolean  @default(true)
  matchCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("dlp_rules")
}

model SystemBroadcast {
  id        String    @id @default(uuid())
  creatorId String
  severity  String    @default("INFO") @db.VarChar(20) // "INFO", "WARNING", "CRITICAL"
  message   String    @db.VarChar(500)
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([isActive, createdAt(sort: Desc)], map: "idx_broadcast_active")
  @@map("system_broadcasts")
}

model UserPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique(map: "idx_push_endpoint") @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_push_user")
  @@map("user_push_subscriptions")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique(map: "idx_system_settings_key") @db.VarChar(50)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model Webhook {
  id          String    @id @default(uuid())
  chatId      String
  creatorId   String
  name        String    @db.VarChar(100)
  token       String    @unique(map: "idx_webhook_token") @db.VarChar(64)
  secret      String    @db.VarChar(64)
  direction   String    @default("INBOUND") @db.VarChar(20) // "INBOUND" or "OUTBOUND"
  targetUrl   String?   @db.VarChar(500)                    // Only for OUTBOUND
  events      String    @default("message:created") @db.VarChar(255)
  isActive    Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chat    Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User @relation("WebhookCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "idx_webhooks_chat")
  @@map("webhooks")
}

model ScheduledReminder {
  id           String    @id @default(uuid())
  chatId       String
  userId       String
  reminderText String    @db.VarChar(500)
  remindAt     DateTime
  isTriggered  Boolean   @default(false)
  triggeredAt  DateTime?
  createdAt    DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([remindAt, isTriggered], map: "idx_reminders_trigger")
  @@map("scheduled_reminders")
}

model Poll {
  id            String       @id @default(uuid())
  chatId        String
  creatorId     String
  question      String       @db.VarChar(500)
  allowMultiple Boolean      @default(false)
  isClosed      Boolean      @default(false)
  createdAt     DateTime     @default(now())

  chat    Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User         @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([chatId, createdAt(sort: Desc)], map: "idx_polls_chat_created")
  @@map("polls")
}

model PollOption {
  id       String     @id @default(uuid())
  pollId   String
  text     String     @db.VarChar(255)
  orderIdx Int        @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId], map: "idx_poll_option_user_unique")
  @@map("poll_votes")
}

model ChannelMetadata {
  id              String   @id @default(uuid())
  chatId          String   @unique(map: "idx_channel_chat_id")
  isBroadcastOnly Boolean  @default(true)
  subscriberCount Int      @default(0)
  publicSlug      String?  @unique(map: "idx_channel_slug") @db.VarChar(50)
  description     String?  @db.VarChar(500)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("channel_metadata")
}

model PinnedMessage {
  id         String    @id @default(uuid())
  chatId     String
  messageId  String
  pinnedById String
  expiresAt  DateTime? // Optional duration auto-unpin
  pinnedAt   DateTime  @default(now())

  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([chatId, messageId], map: "idx_chat_pinned_unique")
  @@index([chatId, pinnedAt(sort: Desc)], map: "idx_pinned_chat_time")
  @@map("pinned_messages")
}

model StarredMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  starredAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId], map: "idx_user_starred_unique")
  @@index([userId, starredAt(sort: Desc)], map: "idx_starred_user_time")
  @@map("starred_messages")
}
